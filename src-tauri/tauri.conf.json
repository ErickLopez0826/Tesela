{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Window Manager",
  "version": "0.1.0",
  "identifier": "com.erick.windowmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Window Manager", "width": 900, "height": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
